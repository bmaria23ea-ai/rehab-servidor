@inherits LayoutComponentBase

<div class="pagina">
    <header class="barra">
        <a class="marca" href="/">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><rect x="1" y="1" width="26" height="26" rx="7" stroke="#8FB8E0" stroke-width="2"></rect><path d="M8 18c2-5 4-8 6-8s4 3 6 8" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round"></path><circle cx="14" cy="8" r="1.8" fill="#FFFFFF"></circle></svg>
            <span><strong>Rehabilitación RV</strong><small>Portal del terapeuta</small></span>
        </a>
        @if (Http?.User.Identity?.IsAuthenticated == true)
        {
            <nav class="enlaces" aria-label="Principal">
                <NavLink href="/" Match="NavLinkMatch.All">Inicio</NavLink>
                <NavLink href="/sesiones">Sesiones</NavLink>
                <NavLink href="/pacientes">Pacientes</NavLink>
                <NavLink href="/visores">Visores</NavLink>
            </nav>
            <form method="post" action="/salir">
                <AntiforgeryToken />
                <button class="secundario" type="submit">Salir</button>
            </form>
        }
    </header>
    <main class="contenido">
        @Body
    </main>
    <footer class="pie">
        <span>Pacientes identificados solo por código</span>
        @if (Http?.User.Identity?.IsAuthenticated == true)
        {
            <span><a href="/actividad">Actividad del portal</a> · <a href="/cambiar-clave">Cambiar contraseña</a></span>
        }
    </footer>
</div>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }
}
