@* Mediciones del terapeuta en la marcha, mismo orden que la ficha: filas = momentos, columnas = parámetros *@
<form method="post" action="/sesiones/@SesionId/mediciones" class="mediciones">
    <AntiforgeryToken />
    @if (Volver is not null)
    {
        <input type="hidden" name="volver" value="@Volver" />
    }
    <div class="med-tabla">
        <table>
            <colgroup><col class="med-c-mom" /><col /><col /><col /><col class="med-c-pa" /></colgroup>
            <thead>
                <tr>
                    <th scope="col"><span class="oculto">Momento</span></th>
                    <th scope="col">FC<small>lpm</small></th>
                    <th scope="col">SpO₂<small>%</small></th>
                    <th scope="col">Borg disnea<small>0–10</small></th>
                    <th scope="col">PA<small>mmHg</small></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Mediciones.Ficha)
                {
                    var v = Datos?.GetValueOrDefault(m.Clave);
                    <tr>
                        <th scope="row">@m.Nombre</th>
                        <td><input name="@(m.Clave)_fc" aria-label="@m.Nombre FC (lpm)" type="number" inputmode="numeric" min="20" max="250" step="1" value="@Mediciones.Valor(v?.Fc)" /></td>
                        <td><input name="@(m.Clave)_spo2" aria-label="@m.Nombre SpO₂ (%)" type="number" inputmode="numeric" min="0" max="100" step="1" value="@Mediciones.Valor(v?.SpO2)" /></td>
                        <td><input name="@(m.Clave)_borg" aria-label="@m.Nombre Borg disnea (0 a 10)" type="number" inputmode="decimal" min="0" max="10" step="0.5" value="@Mediciones.Valor(v?.Borg)" /></td>
                        <td>
                            @if (m.ConPa)
                            {
                                <div class="med-pa">
                                    <input name="@(m.Clave)_pas" aria-label="@m.Nombre PA sistólica (mmHg)" type="number" inputmode="numeric" min="0" max="300" step="1" value="@Mediciones.Valor(v?.PaSis)" />
                                    <span aria-hidden="true">/</span>
                                    <input name="@(m.Clave)_pad" aria-label="@m.Nombre PA diastólica (mmHg)" type="number" inputmode="numeric" min="0" max="300" step="1" value="@Mediciones.Valor(v?.PaDia)" />
                                </div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="fila">
        <button type="submit">Guardar</button>
        @if (Datos is not null)
        {
            <button type="submit" class="claro" formaction="/sesiones/@SesionId/mediciones/borrar" formnovalidate>Borrar</button>
        }
    </div>
</form>

@code {
    [Parameter, EditorRequired] public long SesionId { get; set; }
    [Parameter] public Dictionary<string, Medicion>? Datos { get; set; }
    [Parameter] public string? Volver { get; set; }
}
