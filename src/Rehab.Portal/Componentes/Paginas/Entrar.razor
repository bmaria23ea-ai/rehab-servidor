@page "/entrar"
@attribute [AllowAnonymous]
@inject Terapeutas Repo
@inject Auditoria Log
@inject NavigationManager Nav

<PageTitle>Entrar</PageTitle>

<section class="tarjeta acceso">
    <h1>Portal del terapeuta</h1>
    <form method="post" @formname="entrar" @onsubmit="EntrarAsync">
        <AntiforgeryToken />
        <input name="Datos.Usuario" value="@Datos!.Usuario" placeholder="Usuario" aria-label="Usuario"
               autocomplete="username" autocapitalize="none" required />
        <div class="clave">
            <input name="Datos.Clave" type="password" placeholder="Contraseña" aria-label="Contraseña"
                   autocomplete="current-password" required />
            <OjoClave />
        </div>
        @if (error is not null)
        {
            <p class="error">@error</p>
        }
        <button type="submit">Iniciar sesión</button>
    </form>
    <a class="olvido" href="/recuperar">¿Olvidó su contraseña?</a>
</section>

@code {
    [CascadingParameter] private HttpContext Http { get; set; } = default!;
    [SupplyParameterFromForm] private Formulario? Datos { get; set; }
    private string? error;

    public sealed class Formulario
    {
        public string Usuario { get; set; } = "";
        public string Clave { get; set; } = "";
    }

    protected override void OnInitialized() => Datos ??= new();

    private async Task EntrarAsync()
    {
        var t = await Repo.BuscarAsync(Datos!.Usuario.Trim().ToLowerInvariant());
        bool correcta = false;

        if (t is null || !t.Activo || t.Bloqueado)
        {
            Contrasenas.Verificar(Contrasenas.HashFalso, Datos.Clave);
        }
        else
        {
            correcta = Contrasenas.Verificar(t.Hash, Datos.Clave) != PasswordVerificationResult.Failed;
            if (!correcta)
            {
                await Repo.FalloAsync(t.Id);
                await Log.RegistrarAsync(t.Usuario, "entrar_fallido");
            }
        }

        if (!correcta || t is null)
        {
            error = $"Usuario o contraseña incorrectos. Tras {Terapeutas.MaxIntentos} intentos fallidos la cuenta se bloquea {Terapeutas.MinutosBloqueo} minutos.";
            return;
        }

        await Repo.AccesoAsync(t.Id);
        await Log.RegistrarAsync(t.Usuario, "entrar");
        await Sesion.EntrarAsync(Http, t);
        Nav.NavigateTo(t.DebeCambiar ? "/cambiar-clave" : "/");
    }
}
