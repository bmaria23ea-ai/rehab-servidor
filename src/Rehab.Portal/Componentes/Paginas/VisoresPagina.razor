@page "/visores"
@inject Visores Repo

<PageTitle>Visores</PageTitle>

<div class="encabezado">
    <div>
        <h1>Visores</h1>
        <span class="subtitulo">Asigne el paciente antes de colocarle el visor.</span>
    </div>
</div>

@if (Ok is not null && Mensajes.TryGetValue(Ok, out var ok))
{
    <p class="exito">@ok</p>
}
@if (Error is not null && Errores.TryGetValue(Error, out var error))
{
    <p class="error">@error</p>
}

<details class="bloque" open="@(Error is "codigo" or "nombre" or "solicitud" or "duplicado")">
    <summary>+ Vincular visor</summary>
    <p class="ayuda">En el visor pulse <strong>Vincular</strong> y escriba aquí el código que aparece. El nombre lo elige usted, por ejemplo el número de la etiqueta del visor.</p>
    <form method="post" action="/visores/aprobar">
        <AntiforgeryToken />
        <label>Código del visor
            <input name="codigo" autocapitalize="characters" autocomplete="off" required />
        </label>
        <label>Nombre
            <input name="nombre" maxlength="40" autocomplete="off" required />
        </label>
        <button type="submit">Vincular</button>
    </form>
</details>

@if (lista.Count == 0)
{
    <p class="ayuda">No hay visores vinculados.</p>
}

@foreach (var v in lista)
{
    <article class="ficha">
        <header>
            <strong>@v.Nombre</strong>
            @if (v.Estado != "activo")
            {
                <span class="estado pendiente">Vinculando…</span>
            }
            else if (v.Paciente is not null)
            {
                <span class="estado neutro">En uso</span>
            }
            else
            {
                <span class="estado activo">Disponible</span>
            }
        </header>

        @if (v.Estado == "activo")
        {
            if (v.Paciente is not null)
            {
                <p>Paciente asignado: <strong>@v.Paciente</strong> <span class="ayuda">hasta las @(v.Expira is { } e ? Hora.SoloHora(e) : "-")</span></p>
            }

            <form method="post" action="/visores/@v.Id/asignar" class="fila">
                <AntiforgeryToken />
                <select name="paciente" aria-label="Paciente" required>
                    <option value="" disabled selected="@(v.Paciente is null)">Elegir paciente</option>
                    @foreach (var c in pacientes)
                    {
                        <option value="@c" selected="@(c == v.Paciente)">@c</option>
                    }
                </select>
                <button type="submit">@(v.Paciente is null ? "Asignar" : "Cambiar")</button>
            </form>

            @if (v.Paciente is not null)
            {
                <form method="post" action="/visores/@v.Id/quitar">
                    <AntiforgeryToken />
                    <button class="claro" type="submit">Liberar visor</button>
                </form>
            }
        }
        else
        {
            <p class="ayuda">Espere unos segundos y recargue la página.</p>
        }

        <details class="avanzado">
            <summary class="peligro">Desvincular visor</summary>
            <p class="ayuda">Solo si se perdió, se restableció o ya no se usará. Dejará de enviar sesiones hasta volver a vincularlo. Las sesiones guardadas no se borran.</p>
            <form method="post" action="/visores/revocar">
                <AntiforgeryToken />
                <input type="hidden" name="visor" value="@v.Id" />
                <label class="casilla">
                    <input type="checkbox" name="confirmar" value="si" required />
                    Confirmo desvincular @v.Nombre
                </label>
                <button class="rojo" type="submit">Desvincular</button>
            </form>
        </details>
    </article>
}

@code {
    [SupplyParameterFromQuery] private string? Ok { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    private List<VisorFila> lista = [];
    private List<string> pacientes = [];

    private static readonly Dictionary<string, string> Mensajes = new()
    {
        ["aprobado"] = "Visor aprobado. Se vinculará en unos segundos.",
        ["asignado"] = "Listo. El visor mostrará al paciente en unos segundos.",
        ["quitado"] = "Visor liberado.",
        ["revocado"] = "Visor desvinculado.",
    };

    private static readonly Dictionary<string, string> Errores = new()
    {
        ["codigo"] = "El código no es válido. Escríbalo como aparece en el visor.",
        ["nombre"] = "Nombre no válido: hasta 40 letras, números, espacios, punto o guion.",
        ["solicitud"] = "Ese código no está vigente. Pulse otra vez Vincular en el visor.",
        ["duplicado"] = "Ya existe un visor con ese nombre.",
        ["paciente"] = "Elija un paciente.",
        ["asignar"] = "No se pudo asignar. Recargue la página e intente de nuevo.",
        ["confirmar"] = "Marque la casilla para confirmar.",
    };

    protected override async Task OnInitializedAsync()
    {
        lista = await Repo.ListarAsync();
        pacientes = await Repo.CodigosPacientesAsync();
    }
}
