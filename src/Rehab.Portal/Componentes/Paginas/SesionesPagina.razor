@page "/sesiones"
@inject Sesiones Repo
@inject Visores Gafas

<PageTitle>Sesiones</PageTitle>

<section class="panel">
    <h1>Sesiones</h1>

    <form method="get" class="fila">
        <select name="paciente">
            <option value="" selected="@(string.IsNullOrEmpty(Paciente))">Todos los pacientes</option>
            <option value="@Sesiones.SinPaciente" selected="@(Paciente == Sesiones.SinPaciente)">Sin paciente</option>
            @foreach (var c in pacientes)
            {
                <option value="@c" selected="@(c == Paciente)">@c</option>
            }
        </select>
        <button type="submit">Ver</button>
    </form>

    @if (lista.Count == 0)
    {
        <p>No hay sesiones.</p>
    }

    @foreach (var s in lista)
    {
        <a class="sesion" href="/sesiones/@s.Id">
            <span class="cabeza">
                <strong>@(s.Paciente ?? "Sin paciente")</strong>
                @if (s.EsPrueba) { <span class="etiqueta">prueba</span> }
                <span class="fecha">@Hora.FechaHora(s.Inicio)</span>
            </span>
            <span class="dato">@Textos.Ejercicio(s.Ejercicio): <strong>@Textos.Num(s.DistanciaM) m</strong> en @Textos.Minutos(s.DuracionS)</span>
            <span class="estado @(s.Estado == "completa" ? "activo" : "pendiente")">@Textos.Motivo(s.Motivo)</span>
        </a>
    }
</section>

@code {
    [SupplyParameterFromQuery] private string? Paciente { get; set; }
    private List<SesionFila> lista = [];
    private List<string> pacientes = [];

    protected override async Task OnInitializedAsync()
    {
        pacientes = await Gafas.CodigosPacientesAsync();
        lista = await Repo.ListarAsync(Paciente);
    }
}
