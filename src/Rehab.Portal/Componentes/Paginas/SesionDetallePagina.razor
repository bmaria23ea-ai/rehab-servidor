@page "/sesiones/{Id:long}"
@using System.Globalization
@inject Sesiones Repo
@inject Visores VisoresRepo
@inject Observaciones Notas

<PageTitle>Sesión</PageTitle>

@if (d is null)
{
    <a class="volver" href="/sesiones">‹ Sesiones</a>
    <p>La sesión no existe.</p>
}
else
{
    var s = d.Sesion;
    <a class="volver" href="@(s.Paciente is null ? "/" : $"/pacientes/{s.Paciente}")">‹ @(s.Paciente ?? "Inicio")</a>

    <div class="encabezado">
        <div>
            <span class="subtitulo">@Textos.Ejercicio(s.Ejercicio) · @s.Visor · Sesión @s.Codigo</span>
            <h1>@Hora.FechaHora(s.Inicio) @if (s.EsPrueba) { <span class="etiqueta">prueba</span> }</h1>
        </div>
        <span class="estado @(s.Completa ? "activo" : "pendiente")">@Textos.Motivo(s.Motivo)</span>
    </div>

    @if (Ok == "asignada") { <p class="exito">Sesión asignada.</p> }
    @if (Ok == "paciente") { <p class="exito">Paciente de la sesión guardado.</p> }
    @if (Error == "paciente") { <p class="error">No se pudo cambiar el paciente.</p> }
    @if (Ok == "observacion") { <p class="exito">Observación guardada.</p> }
    @if (Ok == "borrada") { <p class="exito">Observación borrada.</p> }
    @if (Error == "asignar") { <p class="error">No se pudo asignar. Elija un paciente.</p> }
    @if (Error == "observacion") { <p class="error">No se pudo guardar. Escriba la observación (máximo @Observaciones.Maximo caracteres).</p> }

    <div class="resumen">
        <div><span>Distancia</span><strong>@Textos.Num(s.DistanciaM, "0.##") m</strong></div>
        <div><span>Tiempo de exposición</span><strong>@Textos.Minutos(s.DuracionS)</strong></div>
        <div><span>Veces que se detuvo</span><strong>@Textos.Paradas(s.Paradas)</strong></div>
        <div><span>Tiempo detenido</span><strong>@Textos.Segundos(s.DetenidoS)</strong></div>
    </div>

    @if (d.Minutos.Count > 0)
    {
        var max = d.Minutos.Max() is > 0 and var m ? m : 1;
        <section class="panel">
            <h2>Metros en cada minuto</h2>
            <div class="barras">
                @for (int i = 0; i < d.Minutos.Count; i++)
                {
                    <div class="barra-fila">
                        <span>Min @(i + 1)</span>
                        <progress value="@d.Minutos[i].ToString(CultureInfo.InvariantCulture)" max="@max.ToString(CultureInfo.InvariantCulture)"></progress>
                        <span>@Textos.Num(d.Minutos[i], "0.##") m</span>
                    </div>
                }
            </div>
        </section>
    }

    <section class="panel">
        <form method="post" action="/sesiones/@s.Id/observacion">
            <AntiforgeryToken />
            <label>Observaciones
                <textarea name="texto" maxlength="@Observaciones.Maximo" required>@(nota?.Texto)</textarea>
            </label>
            <p class="ayuda">No escriba nombres ni datos que identifiquen al paciente.</p>
            <div class="fila">
                <button type="submit">Guardar</button>
                @if (nota is not null)
                {
                    <button type="submit" class="claro" formaction="/sesiones/@s.Id/observacion/borrar" formnovalidate>Borrar</button>
                }
            </div>
            @if (nota is not null)
            {
                <p class="ayuda">Guardado @Hora.FechaHora(nota.Actualizado) · @nota.Terapeuta</p>
            }
        </form>
    </section>

    <section class="panel">
        <h2>Paciente de la sesión</h2>
        <form method="post" action="/sesiones/@s.Id/paciente" class="fila">
            <AntiforgeryToken />
            <select name="paciente" aria-label="Paciente">
                <option value="" selected="@(s.Paciente is null)">Sin paciente</option>
                @foreach (var c in pacientes)
                {
                    <option value="@c" selected="@(c == s.Paciente)">@c</option>
                }
            </select>
            <button type="submit">Guardar</button>
        </form>
        <p class="ayuda">Si la sesión quedó con el paciente equivocado, elija el correcto o déjela sin paciente.</p>
    </section>
}

@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery] private string? Ok { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    private SesionDetalle? d;
    private Observacion? nota;
    private List<string> pacientes = [];

    protected override async Task OnInitializedAsync()
    {
        if (Id <= 0) return;
        d = await Repo.BuscarAsync((ulong)Id);
        if (d is null) return;
        nota = await Notas.BuscarAsync((ulong)Id);
        pacientes = await VisoresRepo.CodigosPacientesAsync();
    }
}
