@page "/sesiones/{Id:long}"
@using System.Globalization
@inject Sesiones Repo
@inject Visores Gafas

<PageTitle>Sesión</PageTitle>

<section class="panel">
    <p><a href="/sesiones">← Sesiones</a></p>

    @if (d is null)
    {
        <p>La sesión no existe.</p>
    }
    else
    {
        var s = d.Sesion;
        <h1>@Textos.Ejercicio(s.Ejercicio) · @(s.Paciente ?? "Sin paciente")</h1>
        <p class="ayuda">@Hora.FechaHora(s.Inicio) @if (s.EsPrueba) { <span class="etiqueta">prueba</span> }</p>

        @if (Ok == "asignada") { <p class="exito">Sesión asignada.</p> }
        @if (Error == "asignar") { <p class="error">No se pudo asignar. Elija un paciente.</p> }

        <div class="resumen">
            <div><span>Distancia</span><strong>@Textos.Num(s.DistanciaM) m</strong></div>
            <div><span>Duración</span><strong>@Textos.Minutos(s.DuracionS)</strong></div>
            <div><span>Paradas</span><strong>@(d.Paradas?.ToString() ?? "-")</strong></div>
            <div><span>Tiempo detenido</span><strong>@Textos.Num(d.TiempoDetenidoS) s</strong></div>
        </div>

        <p><span class="estado @(s.Estado == "completa" ? "activo" : "pendiente")">@Textos.Motivo(s.Motivo)</span>
            @if (s.Estado != "completa") { <span class="ayuda"> (prevista de @Textos.Minutos(d.DuracionConfiguradaS))</span> }</p>

        @if (d.Minutos.Count > 0)
        {
            var max = d.Minutos.Max() is > 0 and var m ? m : 1;
            <h2>Metros por minuto</h2>
            <div class="barras">
                @for (int i = 0; i < d.Minutos.Count; i++)
                {
                    <div class="barra-fila">
                        <span>Min @(i + 1)</span>
                        <progress value="@d.Minutos[i].ToString(CultureInfo.InvariantCulture)" max="@max.ToString(CultureInfo.InvariantCulture)"></progress>
                        <span>@Textos.Num(d.Minutos[i]) m</span>
                    </div>
                }
            </div>
        }

        @if (s.Paciente is null)
        {
            <h2>Asignar a un paciente</h2>
            <form method="post" action="/sesiones/@s.Id/asignar" class="fila">
                <AntiforgeryToken />
                <select name="paciente" required>
                    <option value="" disabled selected>Elegir paciente</option>
                    @foreach (var c in pacientes)
                    {
                        <option value="@c">@c</option>
                    }
                </select>
                <button type="submit">Asignar</button>
            </form>
        }

        @if (d.LargoPistaM is not null)
        {
            <p class="ayuda">Largo de la pista: @Textos.Num(d.LargoPistaM) m</p>
        }
    }
</section>

@code {
    [Parameter] public long Id { get; set; }
    [SupplyParameterFromQuery] private string? Ok { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }
    private SesionDetalle? d;
    private List<string> pacientes = [];

    protected override async Task OnInitializedAsync()
    {
        d = Id > 0 ? await Repo.BuscarAsync((ulong)Id) : null;
        if (d?.Sesion.Paciente is null) pacientes = await Gafas.CodigosPacientesAsync();
    }
}
